{
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "paid",
        "canceled",
        "archived"
      ]
    },
    "payment_term_id": {
      "type": "integer"
    },
    "delivery_method_id": {
      "type": "integer"
    },
    "sales_channel_id": {
      "type": "integer"
    },
    "salesperson_id": {
      "type": "integer"
    },
    "quote_id": {
      "type": "integer"
    },
    "instructions": {
      "type": "string"
    },
    "invoiced": {
      "type": "boolean"
    },
    "tax": {
      "type": "number"
    },
    "shipping": {
      "type": "number"
    },
    "discount": {
      "type": "number"
    },
    "price_tier_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "invoice_items_attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Either inventory ID or SKU is required when adding a new invoice item",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Required when editing existing invoice items"
          },
          "inventory_id": {
            "type": "integer",
            "description": "Either inventory ID or SKU is required when adding a new invoice item"
          },
          "sku": {
            "type": "string",
            "description": "Either inventory ID or SKU is required when adding a new invoice item"
          },
          "count": {
            "type": "number",
            "description": "Required when adding a new invoice item"
          },
          "override_unit_price": {
            "type": "number"
          },
          "_destroy": {
            "type": "boolean",
            "description": "Setting this to true will remove the specified invoice item"
          },
          "invoice_item_details_attributes": {
            "$ref": "line_item_details.json"
          }
        }
      }
    },
    "custom_line_items_attributes": {
      "$ref": "custom_line_items.json"
    }
  }
}
