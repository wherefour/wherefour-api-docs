{
  "type": "object",
  "description": "At least one credit item or custom line item is required.",
  "properties": {
    "credit_number": {
      "type": "string"
    },
    "credit_date": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "order_id": {
      "type": "integer"
    },
    "invoice_id": {
      "type": "integer"
    },
    "salesperson_id": {
      "type": "integer"
    },
    "credit_from_address_id": {
      "type": "integer",
      "description": "Facility Address ID, not Facility ID or Customer Address ID"
    },
    "customer_message": {
      "type": "string",
      "nullable": true
    },
    "internal_notes": {
      "type": "string",
      "nullable": true
    },
    "credit_items_attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "inventory_id": {
            "type": "integer"
          },
          "count": {
            "type": "number"
          },
          "override_unit_price": {
            "type": "number"
          },
          "credit_item_details_attributes": {
            "$ref": "line_item_details.json"
          }
        },
        "required": [
          "inventory_id",
          "count"
        ]
      }
    },
    "custom_line_items_attributes": {
      "$ref": "custom_line_items.json"
    }
  },
  "required": [
    "credit_number",
    "credit_date",
    "status"
  ]
}
