{
  "type": "object",
  "description": "At least one order item is required.",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "order_date": {
      "type": "string"
    },
    "order_status_id": {
      "type": "integer"
    },
    "price_tier_id": {
      "type": "integer"
    },
    "ship_from_address_id": {
      "type": "integer",
      "description": "Facility Address ID, not Facility ID or Customer Address ID"
    },
    "po_number": {
      "type": "string"
    },
    "payment_term_id": {
      "type": "integer",
      "nullable": true
    },
    "deliver_date": {
      "type": "string"
    },
    "produce_date": {
      "type": "string"
    },
    "ship_date": {
      "type": "string"
    },
    "delivery_method_id": {
      "type": "integer"
    },
    "sales_channel_id": {
      "type": "integer"
    },
    "salesperson_id": {
      "type": "integer",
      "nullable": true
    },
    "quote_id": {
      "type": "integer"
    },
    "instructions": {
      "type": "string",
      "nullable": true
    },
    "internal_notes": {
      "type": "string",
      "nullable": true
    },
    "invoiced": {
      "type": "boolean"
    },
    "tax": {
      "type": "number"
    },
    "shipping": {
      "type": "number"
    },
    "discount": {
      "type": "number"
    },
    "price_tier_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "order_items_attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Either inventory ID or SKU is required",
        "properties": {
          "inventory_id": {
            "type": "integer"
          },
          "sku": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "override_unit_price": {
            "type": "number"
          },
          "order_item_details_attributes": {
            "$ref": "line_item_details.json"
          }
        },
        "required": [
          "count"
        ]
      }
    },
    "custom_line_items_attributes": {
      "$ref": "custom_line_items.json"
    }
  },
  "required": [
    "order_number",
    "order_date",
    "order_items_attributes"
  ]
}
