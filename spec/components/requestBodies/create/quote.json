{
  "type": "object",
  "description": "At least one quote item is required.",
  "properties": {
    "quote_number": {
      "type": "string"
    },
    "quote_date": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "payment_term_id": {
      "type": "integer",
      "nullable": true
    },
    "price_tier_name": {
      "type": "string"
    },
    "price_tier_id": {
      "type": "integer"
    },
    "sales_channel_id": {
      "type": "integer"
    },
    "salesperson_id": {
      "type": "integer",
      "nullable": true
    },
    "delivery_method_id": {
      "type": "integer"
    },
    "instructions": {
      "type": "string",
      "nullable": true
    },
    "tax": {
      "type": "number"
    },
    "shipping": {
      "type": "number"
    },
    "discount": {
      "type": "number"
    },
    "price_tier_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "quote_items_attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Either inventory ID or SKU is required",
        "properties": {
          "inventory_id": {
            "type": "integer"
          },
          "sku": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "override_unit_price": {
            "type": "number"
          },
          "quote_item_details_attributes": {
            "$ref": "line_item_details.json"
          }
        },
        "required": [
          "count"
        ]
      }
    }
  },
  "required": [
    "quote_date",
    "status",
    "quote_items_attributes"
  ]
}
