{
  "type": "object",
  "description": "At least one invoice item is required.",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Not generated automatically, so send the number you want on the invoice"
    },
    "invoice_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "paid",
        "canceled",
        "archived"
      ]
    },
    "payment_term_id": {
      "type": "integer",
      "nullable": true
    },
    "delivery_method_id": {
      "type": "integer"
    },
    "sales_channel_id": {
      "type": "integer"
    },
    "salesperson_id": {
      "type": "integer",
      "nullable": true
    },
    "quote_id": {
      "type": "integer"
    },
    "instructions": {
      "type": "string",
      "nullable": true
    },
    "tax": {
      "type": "number"
    },
    "shipping": {
      "type": "number"
    },
    "discount": {
      "type": "number"
    },
    "price_tier_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "invoice_items_attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Either inventory ID or SKU is required",
        "properties": {
          "inventory_id": {
            "type": "integer"
          },
          "sku": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "override_unit_price": {
            "type": "number"
          },
          "invoice_item_details_attributes": {
            "$ref": "line_item_details.json"
          }
        },
        "required": [
          "count"
        ]
      }
    },
    "custom_line_items_attributes": {
      "$ref": "custom_line_items.json"
    }
  },
  "required": [
    "invoice_number",
    "invoice_date",
    "status",
    "invoice_items_attributes"
  ]
}
