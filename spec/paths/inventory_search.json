{
  "get": {
    "summary": "Search for inventory item",
    "parameters": [
      {
        "in": "query",
        "name": "page",
        "description": "Results page to view",
        "schema": {
          "type": "integer"
        }
      }
    ],
    "tags": [
      "Inventory"
    ],
    "responses": {
      "200": {
        "description": "OK",
        "headers": {
          "Total": {
            "schema": {
              "type": "integer"
            },
            "description": "Total count of results"
          },
          "Per-Page": {
            "schema": {
              "type": "integer"
            },
            "description": "Number of results per page"
          },
          "Link": {
            "schema": {
              "type": "string"
            },
            "description": "URLs for the next or previous pages of the results"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "$ref": "../components/schemas/inventory.json"
              }
            },
            "examples": {
              "Example": {
                "value": [
                  {
                    "id": 3,
                    "name": "Bulk chocolate",
                    "category_name": "Ingredients",
                    "on_hand": "0.0",
                    "unit_of_use": "pound",
                    "unit_of_purchase": "pound",
                    "purchase_conversion": "1.0",
                    "property": "work_in_progress",
                    "sku": "123456",
                    "upc": "AAABBB",
                    "pull_strategy": "Hand Pick",
                    "reorder_point": "10.0",
                    "lead_time": 0,
                    "retired": false,
                    "waste_percentage": "0.0",
                    "created_at": "2020-09-11T13:57:46.825Z",
                    "updated_at": "2020-09-11T13:57:46.825Z"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "operationId": "search_inventory",
    "description": "Returns inventory items that match the given name or SKU. Multiple matches may be returned.",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Part of the inventory item's name"
              },
              "sku_list": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "description": "One SKU, or an array of SKUs"
              },
              "location_id": {
                "type": "integer"
              }
            },
            "description": "Searches by name, or by one SKU or a list of SKUs. `location_id` narrows the results to stock at that location."
          },
          "examples": {
            "Name": {
              "value": {
                "name": "Product Name Here"
              }
            },
            "Single SKU": {
              "value": {
                "sku_list": "123456"
              }
            },
            "Multiple SKUs": {
              "value": {
                "sku_list": [
                  "SK001",
                  "SK002"
                ]
              }
            }
          }
        }
      },
      "description": "Search can be performed based on EITHER the inventory item name, OR a single SKU or an array of SKUs. The inventory item name will take precedence over the SKU parameter. Multiple matches may be returned."
    }
  }
}
