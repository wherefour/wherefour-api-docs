  "patch": {
    "summary": "Update purchase order",
    "description": "Updates one of the vendor's purchase orders. A purchase order can't be changed once stock has been received against it; the request returns 422. Each line's unit price comes from the vendor's price list for its quantity, unless `override_unit_price` is sent. The subtotal and total are always worked out by Wherefour.",
    "tags": [
      "Purchases"
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../components/requestBodies/update/purchase.json"
          },
          "examples": {
            "Example": {
              "value": {
                "status": "open",
                "purchase_items_attributes": [
                  {
                    "id": 311,
                    "count": 12,
                    "purchase_item_details_attributes": [
                      {
                        "id": 52,
                        "note": "Stack no more than 3 high."
                      },
                      {
                        "id": 53,
                        "_destroy": true
                      },
                      {
                        "kind": "custom_line_item",
                        "custom_line_item_attributes": {
                          "custom_line_definition_id": 6,
                          "count": 2
                        }
                      }
                    ]
                  },
                  {
                    "inventory_id": 42,
                    "count": 4,
                    "override_unit_price": 18.5
                  }
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
