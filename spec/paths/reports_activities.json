{
  "post": {
    "summary": "Get inventory adjustment activity for a date range",
    "description": "Lists inventory adjustment activity for a date range. The IDs of records returned are for the adjustment record.",
    "parameters": [
      {
        "in": "query",
        "name": "start_date_time",
        "description": "Start date/time for the oldest adjustment record to return, based on the adjustment's effective_at timestamp",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "in": "query",
        "name": "end_date_time",
        "description": "End date/time for the newest adjustment record to return, based on the adjustment's effective_at timestamp",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "in": "query",
        "name": "activity_types",
        "description": "Restrict records to the provided adjustment activity types",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "category_ids",
        "description": "Restrict records to inventory and stock lot that belong to the provided category IDs",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "customer_ids",
        "description": "Restrict records to activity associated with specific customer IDs",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "inventory_ids",
        "description": "Restrict records to the provided inventory IDs",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "location_ids",
        "description": "Restrict records to the provided location IDs",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "statuses",
        "description": "Restrict records to stock lots with the provided statuses",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "user_ids",
        "description": "Restrict records to adjustments made by the provided used IDs",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "vendor_ids",
        "description": "Restrict records to activity associated with specific vendor IDs",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "lot_code",
        "description": "Restrict records to adjustments made only to stock lots with the provided lot code",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "barcode",
        "description": "Restrict records to adjustments made only to stock lots with the provided barcode",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "serial_number",
        "description": "Restrict records to adjustments made only to stock lots with the provided serial number",
        "schema": {
          "type": "array"
        }
      },
      {
        "in": "query",
        "name": "page",
        "description": "Results page to view",
        "schema": {
          "type": "integer"
        }
      }
    ],
