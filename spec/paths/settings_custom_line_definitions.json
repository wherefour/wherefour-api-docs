{
  "get": {
    "summary": "List custom line definitions",
    "description": "Lists the custom line definitions for custom line items, sorted by name. Use a definition's `id` as `custom_line_definition_id` when adding custom line items to a document, or to a document's lines in `*_item_details_attributes`. Inactive definitions are included unless filtered out.",
    "parameters": [
      {
        "in": "query",
        "name": "page",
        "description": "Results page to view",
        "schema": {
          "type": "integer"
        }
      },
      {
        "in": "query",
        "name": "per_page",
        "description": "Results per page, up to 100",
        "schema": {
          "type": "integer"
        }
      },
      {
        "in": "query",
        "name": "active",
        "description": "Only active (`true`) or inactive (`false`) definitions",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "in": "query",
        "name": "document",
        "description": "Only definitions that can be used on this kind of document",
        "schema": {
          "type": "string",
          "enum": [
            "credits",
            "invoices",
            "orders",
            "purchases",
            "quotes",
            "shipments",
            "standing_orders"
          ]
        }
      },
      {
        "in": "query",
        "name": "customer_id",
        "description": "Only definitions open to all customers or limited to this customer",
        "schema": {
          "type": "integer"
        }
      },
      {
        "in": "query",
        "name": "vendor_id",
        "description": "Only definitions open to all vendors or limited to this vendor",
        "schema": {
          "type": "integer"
        }
      },
      {
        "in": "query",
        "name": "updated_at",
        "description": "Only definitions updated on or after this time",
        "schema": {
          "type": "string"
        }
      }
    ],
    "tags": [
      "Settings"
    ],
    "responses": {
      "200": {
        "description": "OK",
        "headers": {
          "Total": {
            "schema": {
              "type": "integer"
            },
            "description": "Total count of results"
          },
          "Per-Page": {
            "schema": {
              "type": "integer"
            },
            "description": "Number of results per page"
          },
          "Link": {
            "schema": {
              "type": "string"
            },
            "description": "URLs for the next or previous pages of the results"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "$ref": "../components/schemas/custom_line_definition.json"
              }
            },
            "examples": {
              "Example": {
                "value": [
                  {
                    "id": 4,
                    "name": "Freight",
                    "description": "Inbound freight charge",
                    "active": true,
                    "line_item_calculation_type": "additive",
                    "unit_of_measurement": "each",
                    "credits_allowed": false,
                    "credits_mode": "manual",
                    "invoices_allowed": true,
                    "invoices_mode": "manual",
                    "orders_allowed": true,
                    "orders_mode": "manual",
                    "purchases_allowed": true,
                    "purchases_mode": "manual",
                    "quotes_allowed": false,
                    "quotes_mode": "manual",
                    "shipments_allowed": false,
                    "shipments_mode": "manual",
                    "standing_orders_allowed": false,
                    "standing_orders_mode": "manual",
                    "customers_allowed": false,
                    "vendors_allowed": false,
                    "created_at": "2026-10-01T16:20:11.512Z",
                    "updated_at": "2026-10-01T16:20:11.512Z"
                  }
                ]
              }
            }
          }
        }
      },
      "404": {
        "description": "The customer or vendor wasn't found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "operationId": "get_custom_line_definitions"
  }
}
